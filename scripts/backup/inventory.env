# GMEPay+ stateful-surface inventory — SINGLE SOURCE OF TRUTH for backup/restore.
#
# Derived mechanically from docker-compose.yml (volumes: + services:) and
# deploy/helm/gmepay/values.yaml (SPRING_DATASOURCE_URL / SPRING_DATA_MONGODB_URI).
# Sourced by gmepay-backup.sh and gmepay-restore.sh — do NOT duplicate this list
# in either script.
#
# WHEN YOU ADD A DATABASE TO docker-compose.yml YOU MUST ADD IT HERE, or it will
# silently not be backed up. scripts/backup/check-inventory.sh fails if the two
# drift apart; wire it into CI next to the other static checks.
#
# Row format (pipe-separated, no spaces around |):
#   <compose-service>|<database>|<db-user>|<published-host-port>|<owning-microservice>
#
# The scripts reach the databases via `docker exec <container>` (not the host
# port), so pg_dump always matches the server version (postgres:16-alpine) and no
# psql client is required on the host. Host ports are recorded for operators and
# for the documented off-host / ad-hoc path.

PG_INVENTORY="
postgres-config|configreg|gmepay|5433|config-registry
postgres-txn|txndb|gmepay|5434|transaction-mgmt
postgres-prefunding|prefunding|gmepay|5435|prefunding
postgres-ledger|ledger|gmepay|5436|revenue-ledger
postgres-settlement|settlement|gmepay|5437|settlement-reconciliation
postgres-notify|notify|gmepay|5438|notification-webhook
postgres-authid|authid|gmepay|5439|auth-identity
postgres-scheme|zpadapter|gmepay|5440|scheme-adapter-zeropay
postgres-executor|executor|gmepay|5441|payment-executor
postgres-qr|qrdb|gmepay|5442|qr-service
postgres-ratefx|ratefx|gmepay|5443|rate-fx
postgres-reporting|reporting|gmepay|5444|reporting-compliance
postgres-sendmn|smnadapter|gmepay|5445|scheme-adapter-sendmn
postgres-keycloak|keycloak|keycloak|5446|keycloak
postgres-ninepay|npadapter|gmepay|5447|scheme-adapter-ninepay
"

# ── PITR / WAL streaming set (gap T3-8) ──────────────────────────────────────
# The MONEY-CRITICAL clusters. A nightly logical dump gives these a 24h RPO, which
# is not acceptable once real money moves, so these — and only these — additionally
# get continuous WAL streaming (pg_receivewal) + a periodic base backup, which is
# what makes point-in-time recovery possible. See gmepay-pitr.sh and
# Documentation/RUNBOOK_BACKUP_DR.md §4a.
#
# WHY THESE FIVE
#   postgres-config      the fleet cannot route or price without configreg
#   postgres-txn         the transaction ledger of record + event outbox
#   postgres-prefunding  float balances / holds — money positions
#   postgres-ledger      revenue postings, GL vouchers
#   postgres-executor    idempotency keys; losing them risks DOUBLE EXECUTION,
#                        which is worse than losing a record of a payment
# The other ten stay nightly-dump-only. Add a service here and it is picked up by
# every gmepay-pitr.sh action — but read the disk-retention warning in that script
# first: each streamed cluster costs a replication slot on the primary.
PITR_SERVICES="postgres-config postgres-txn postgres-prefunding postgres-ledger postgres-executor"

# Physical replication slot name created on each PITR cluster. One name across all
# of them; they are separate clusters so there is no collision.
PITR_SLOT_NAME="gmepay_walrcv"

# Where streamed WAL + base backups land. MUST NOT be on the same disk as the
# Docker volumes, or a disk failure takes the data and its recovery source together.
PITR_ARCHIVE_ROOT_DEFAULT="/var/backups/gmepay-wal"

# Bound on how much WAL a primary will retain for a DEAD receiver before it
# invalidates the slot. Without this an unnoticed receiver outage fills pg_wal and
# PostgreSQL shuts down — i.e. the backup mechanism causes the outage. Applied by
# `gmepay-pitr.sh --init` with ALTER SYSTEM + pg_reload_conf() (reload only, NO
# restart). Losing the slot costs PITR continuity; filling the disk costs the money
# path. The trade is deliberate and this is the safe side of it.
PITR_MAX_SLOT_WAL_KEEP_SIZE_DEFAULT="8GB"

# Image the receiver / basebackup containers run. Pin to the SERVER version
# (postgres:16-alpine, as every cluster above) so pg_receivewal and pg_basebackup
# always match the wire protocol they talk to.
PITR_IMAGE_DEFAULT="postgres:16-alpine"

# Compose network key in docker-compose.yml (`networks: gmepay:`). The real Docker
# network is <project>_<key>, e.g. code_gmepay.
PITR_NETWORK_KEY="gmepay"

# ── Mongo ────────────────────────────────────────────────────────────────────
# docker-compose.yml: mongo:7, volume mongo-data:/data/db, port 27017.
# Only one logical DB is used: 'merchant' (merchant-qr-data service).
MONGO_SERVICE="mongo"
MONGO_DBS="merchant"

# ── MinIO ────────────────────────────────────────────────────────────────────
# docker-compose.yml: minio, volume minio-data:/data, ports 9000/9001.
# Bucket name is lib-vault's MinioVaultClient.DEFAULT_BUCKET (ADR-006). The
# bucket is created with object-lock COMPLIANCE retention at boot by
# VaultBucketInitializer, which is why we mirror it OUT rather than snapshot the
# volume: a restore must re-upload objects into a freshly object-locked bucket.
MINIO_SERVICE="minio"
MINIO_BUCKETS="gmepay-partner-vault"
MINIO_ROOT_USER_DEFAULT="gmepay"
MINIO_ROOT_PASSWORD_DEFAULT="gmepay-minio"

# ── Compose container-name prefix ────────────────────────────────────────────
# Compose derives it from the project directory, which is `code`, giving
# `code-postgres-txn-1` etc. Override with GMEPAY_COMPOSE_PROJECT if you run the
# stack with an explicit -p / COMPOSE_PROJECT_NAME.
COMPOSE_PROJECT_DEFAULT="code"

# ── NOT backed up by design — see Documentation/RUNBOOK_BACKUP_DR.md §7 ──────
#   redis            no volume in compose → cache only, rebuilt on demand
#   kafka/zookeeper  NO named volume at all → topic logs + consumer offsets live
#                    in the container writable layer and are LOST on
#                    `docker compose down`. Event replay position is therefore
#                    not recoverable; the DB outbox tables are the durable
#                    record. This is a known gap, not an omission.
#   schema-registry  state lives in the Kafka _schemas topic (same caveat)
#   data/sim-*       simulator fixtures, tracked in git
#   build/bok-out,   generated report/settlement drops — regenerable from the
#   $TMPDIR/gmepay/  reporting-compliance + settlement DBs
#     outbound
