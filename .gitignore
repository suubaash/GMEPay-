.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.idea/
*.iml
*.log
.DS_Store

# Claude Code personal settings (machine-specific, never commit)
.claude/settings.local.json
# Per-app Claude Preview launch configs (machine-specific)
apps/*/.claude/launch.json

# local whole-platform smoke evidence
.smoke/

# docx generator deps (not source)
outputs/docgen/node_modules/

# simulator runtime state written during e2e runs (sim JSONL persistence)
e2e-tests/data/

# ---------------------------------------------------------------------------
# Key material and local secret files — gap T5-5 (CISO audit 2026-07-28 §13).
#
# Before this block the repo had NO rule for any of these patterns, so an
# operator-generated keystore, a partner's signing key or a filled-in .env was
# exactly one `git add -A` away from being committed. The gitleaks job in CI
# (.github/workflows/ci.yml + .gitleaks.toml) is the second line of defence;
# this is the first.
#
# NOTE: .gitignore does NOT affect files git already tracks, so nothing that is
# tracked today disappears. The `!` negations below exist so those files stay
# `git add`-able (re-adding after a delete, a fresh clone + re-add, etc.).
# Every negation was verified against `git ls-files` — see docs/CI.md.
# ---------------------------------------------------------------------------

# Private keys / keystores / certificate bundles carrying private material
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.key
*.asc
*.gpg

# SSH keys
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.ppk

# Local environment files (these are where real credentials end up)
.env
.env.*
*.env
!*.env.example
!.env.example
!.env.sample
!.env.template

# --- Legitimately tracked exceptions (verified with `git ls-files`) ---------
# Non-secret, machine-readable backup inventory (no credentials, just db/user
# names + host ports); consumed by scripts/backup/gmepay-{backup,restore}.sh.
!scripts/backup/inventory.env
# Deterministic X.509 fixtures for the partner mTLS pinning tests. Their private
# halves are NOT in the repo — these are certificates only (expired / future /
# valid / valid2), regenerated by the test that needs them.
!services/config-registry/src/test/resources/certs/*.pem
# NOTE: docker/certs/gme-root-ca.crt (the GME Internal Root CA *public* cert
# consumed by every Dockerfile's keytool step) is deliberately NOT matched —
# `*.crt`/`*.cer` are absent from the list above on purpose, because a public CA
# certificate is not key material. docker/certs/gme-truststore is tracked and
# extension-less, so no pattern above touches it either.
