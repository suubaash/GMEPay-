          "GMEREMIT"
        ]
      }
    },
    {
      "username": "partner-sendmn",
      "email": "partner-sendmn@gmepay.local",
      "firstName": "SendMN",
      "lastName": "Partner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PARTNER_USER"
