          "report.generate"
        ]
      }
    },
    {
      "username": "partner-demo",
      "email": "partner-demo@gmepay.local",
      "firstName": "Demo",
      "lastName": "Partner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PARTNER_USER"
      ],
