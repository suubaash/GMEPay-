# ---------------------------------------------------------------------------
# Partner Portal — local configuration.
# Canonical identity topology: docker/keycloak/README.md §1.
# ---------------------------------------------------------------------------

# Where the Next server proxies /api/* to (SERVER-side only, never shipped to the
# browser). All browser fetches go to the same-origin path /api/* and are
# rewritten here by next.config.mjs.
#
# Do NOT set NEXT_PUBLIC_BFF_BASE_URL: that makes the BROWSER call the BFF
# directly, cross-origin, and the BFF has no CORS configuration anywhere — the
# preflight fails and every panel breaks.
BFF_PROXY_TARGET=http://127.0.0.1:8095

# Keycloak realm base URL as the BROWSER must reach it, and the OIDC client id.
# These must match docker/keycloak/realm-gmepay.json (realm `gmepay`, PUBLIC
# client `partner-portal-ui` with PKCE S256) and the OIDC_ISSUER_URI the BFF
# validates against. Host port 8097 — 8090 belongs to scheme-adapter-zeropay.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8097/realms/gmepay
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=partner-portal-ui

# "true" = AuthGate lands on /login (SSO button) instead of auto-redirecting to
# Keycloak. This is NOT a password bypass — the BFF has no /v1/auth/login handler.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false

# NOTE: NEXT_PUBLIC_PARTNER_ID is gone. The partner code now comes from the
# token's `partner_id` claim; a hardcoded id that disagrees with the claim can
# only produce a 403 from the BFF's partner-scope check.
