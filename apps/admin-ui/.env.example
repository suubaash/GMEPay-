# ---------------------------------------------------------------------------
# Ops/Admin console — local configuration.
# Canonical identity topology: docker/keycloak/README.md §1.
# ---------------------------------------------------------------------------

# Where the Next server proxies /api/* to (SERVER-side only). The browser always
# calls the same-origin path /api/*; do not set NEXT_PUBLIC_BFF_BASE_URL, which
# would make the browser call the BFF cross-origin (the BFF has no CORS config).
BFF_PROXY_TARGET=http://127.0.0.1:8095

# Keycloak realm base URL as the BROWSER must reach it, and the OIDC client id.
# Must match docker/keycloak/realm-gmepay.json (realm `gmepay`, PUBLIC client
# `admin-ui` with PKCE S256) and the OIDC_ISSUER_URI the BFF validates.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8097/realms/gmepay
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=admin-ui

# "true" = AuthGate lands on /login (SSO button) instead of auto-redirecting to
# Keycloak. NOT a password bypass — the BFF has no /v1/auth/login handler.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false
